#!/bin/sh
# iTrade commit gate (P2.6.02): no data/secrets/account numbers, then format, lint, build and tests —
# only for the parts of the repository the commit touches.
# Enabled with: git config core.hooksPath .githooks
# Integration tests run only when the commit touches the database layer and Docker is running; the browser
# tests are not run here — `python tools/ci.py` runs everything, before a phase gate at the latest.
set -e

staged=$(git diff --cached --name-only)

if echo "$staged" | grep -Eq '^data/|(^|/)\.env|\.pem$|\.key$|appsettings\.Local\.json$'; then
    echo "pre-commit: refusing to commit data/, secret or local-config files:" >&2
    echo "$staged" | grep -E '^data/|(^|/)\.env|\.pem$|\.key$|appsettings\.Local\.json$' >&2
    exit 1
fi

# Real IBKR account numbers ("U"/"DU", optional letter, then 6-9 digits) must never be committed;
# all-zero placeholders are fine. Every number is taken out of its line and judged on its own, so a real
# one cannot hide on a line that also has a placeholder.
if git diff --cached -U0 | grep -E '^\+' | grep -oE '\bD?U[A-Z]?[0-9]{6,9}\b' | grep -vqE '^D?U[A-Z]?0{6,9}$'; then
    echo "pre-commit: staged changes contain what looks like a real IBKR account number." >&2
    echo "Replace it with an all-zero placeholder (D)U0000000." >&2
    exit 1
fi

# A migration that is on origin/main may already be applied to a database: it is never changed or removed.
# A schema change is a new migration.
if git rev-parse -q --verify origin/main >/dev/null 2>&1; then
    for file in $(git diff --cached --no-renames --name-only --diff-filter=MD -- src/ITrade.Infrastructure/Persistence/Migrations \
        | grep -E '/[0-9]{14}_[^/]+\.cs$' || true); do
        if git cat-file -e "origin/main:$file" 2>/dev/null; then
            echo "pre-commit: $file is on origin/main - a pushed migration is never edited or removed." >&2
            echo "Add a new migration instead: dotnet ef migrations add <Name> ..." >&2
            exit 1
        fi
    done
fi

# Python: research archive, data pipeline, tools.
if echo "$staged" | grep -Eq '^python/|^config/|^tools/'; then
    echo "pre-commit: python (ruff format, ruff check, pytest)" >&2
    (cd python && uv run --quiet ruff format --check src tests tools \
        && uv run --quiet ruff check src tests tools \
        && uv run --quiet pytest -q -m "not network")
fi

# Spikes: each changed spike must build.
if echo "$staged" | grep -q '^spikes/[^/]*/' && command -v dotnet >/dev/null 2>&1; then
    # only files inside a spike folder (spikes/<name>/...); files directly in spikes/ are shared settings
    for dir in $(echo "$staged" | grep '^spikes/[^/]*/' | cut -d/ -f2 | sort -u); do
        target=$(ls spikes/"$dir"/*.sln* 2>/dev/null | head -n 1)
        if [ -z "$target" ]; then
            target=$(find spikes/"$dir" -name '*.csproj' | head -n 1)
        fi
        if [ -n "$target" ]; then
            dotnet build "$target" --nologo -v q
        fi
    done
fi

# .NET solution: build (warnings are errors), code style, unit and architecture tests.
# web/dist is copied into the Host's output, so a rebuilt interface is picked up by the build as well.
if echo "$staged" | grep -Eq '^(src|tests)/|^ITrade\.slnx$|^Directory\.(Build|Packages)\.props$|^global\.json$|^\.editorconfig$' \
    && command -v dotnet >/dev/null 2>&1; then
    echo "pre-commit: .NET (build, format, unit and architecture tests)" >&2
    dotnet build ITrade.slnx --nologo -v q
    if ! dotnet format ITrade.slnx --verify-no-changes --no-restore -v q; then
        echo "pre-commit: C# formatting or style differs; run: dotnet format ITrade.slnx" >&2
        exit 1
    fi
    dotnet test tests/ITrade.UnitTests --no-build --nologo -v q
    dotnet test tests/ITrade.ArchitectureTests --no-build --nologo -v q
    # What the database itself enforces (the append-only ledger, unique keys, migrations) is proved only on a
    # real PostgreSQL: both defects of P3.1.02 were invisible to the unit tests.
    if echo "$staged" | grep -Eq '^src/ITrade\.Infrastructure/|^tests/ITrade\.IntegrationTests/'; then
        if docker info >/dev/null 2>&1; then
            echo "pre-commit: .NET integration tests (PostgreSQL in Docker)" >&2
            dotnet test tests/ITrade.IntegrationTests --no-build --nologo -v q
        else
            echo "pre-commit: WARNING - Docker is not running, the integration tests were NOT run." >&2
            echo "Start Docker and run: dotnet test tests/ITrade.IntegrationTests" >&2
        fi
    fi
fi

# Web: generated API client is current, format, lint, types, unit tests.
if echo "$staged" | grep -q '^web/'; then
    if ! command -v npm >/dev/null 2>&1 || [ ! -d web/node_modules ]; then
        echo "pre-commit: web/ changed but its tools are not installed; run: npm ci (in web/)" >&2
        exit 1
    fi
    echo "pre-commit: web (API client, format, lint, types, tests)" >&2
    (cd web && npm run --silent gen:api:check \
        && npm run --silent format:check \
        && npm run --silent lint \
        && npm run --silent typecheck \
        && npm test --silent)
fi

exit 0
