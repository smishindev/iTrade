<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>9e176ec1-7c00-479f-8f14-66356838e083</UserSecretsId>
    <!-- The interface is plain files copied to wwwroot (below). The SDK's "static web assets" would add a manifest
         that, in the Development environment only, makes the Host look for src/ITrade.Host/wwwroot and crash at
         start when it is absent (found 2026-10-12: `dotnet run` failed while every test, run as "Testing", passed). -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITrade.Domain\ITrade.Domain.csproj" />
    <ProjectReference Include="..\ITrade.Application\ITrade.Application.csproj" />
    <ProjectReference Include="..\ITrade.Infrastructure\ITrade.Infrastructure.csproj" />
    <ProjectReference Include="..\ITrade.Broker.IBKR\ITrade.Broker.IBKR.csproj" />
  </ItemGroup>

  <!-- The built web interface (`npm run build` in web/) is served from wwwroot next to the Host (P2.5.06). -->
  <ItemGroup>
    <Content Include="..\..\web\dist\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ITrade.UnitTests" />
    <InternalsVisibleTo Include="ITrade.IntegrationTests" />
    <InternalsVisibleTo Include="ITrade.E2EHost" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
